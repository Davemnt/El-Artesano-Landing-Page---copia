rules_version = '2';
/**
 * Reglas de Seguridad de Firestore - El Artesano
 * 
 * ESTRUCTURA DE COLECCIONES:
 * - users: perfiles de usuario (solo lectura/escritura del propio usuario)
 * - courses: metadatos de cursos (lectura pública si published, escritura solo admin)
 * - products: metadatos de productos (lectura pública si published, escritura solo admin)
 * - purchases: registros de compras (lectura propia/admin, escritura servidor/admin)
 * - user_courses: accesos a cursos (lectura propia, escritura solo servidor/admin)
 * - videos_private: videoIds cifrados (SOLO servidor/admin, NUNCA cliente)
 * - video_access_logs: logs de acceso a videos (solo servidor)
 * - payments: registros de pagos MercadoPago (solo servidor/admin)
 * - sales: ventas de productos (solo servidor/admin)
 * 
 * ROLES:
 * - admin: custom claim en auth.token.admin == true
 * - user: cualquier usuario autenticado
 * - anonymous: lectura limitada a recursos públicos
 * 
 * IMPORTANTE:
 * - videos_private NO debe ser accesible desde el cliente
 * - Las Cloud Functions usan Firebase Admin SDK que bypasea estas reglas
 * - Toda lógica sensible (pagos, accesos) debe ejecutarse server-side
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================================
    // FUNCIONES AUXILIARES
    // ========================================================================
    
    // Verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verificar si el usuario es administrador (desde Firestore)
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.admin == true;
    }
    
    // Verificar si el usuario es el dueño del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Verificar si el recurso está publicado
    function isPublished() {
      return resource.data.published == true;
    }
    
    // ========================================================================
    // USUARIOS
    // ========================================================================
    match /users/{userId} {
      // Lectura: solo el propio usuario o admin
      allow read: if isOwner(userId) || isAdmin();
      
      // Creación: 
      // - Usuario puede crear su propio documento (sin roles)
      // - Admin puede crear cualquier usuario (incluyendo roles)
      allow create: if (isOwner(userId) 
                        && request.resource.data.keys().hasAll(['email', 'createdAt'])
                        && !request.resource.data.keys().hasAny(['roles']))
                    || isAdmin();
      
      // Actualización: el usuario puede actualizar sus datos básicos, NO roles
      // Admin puede actualizar cualquier cosa (incluyendo roles)
      allow update: if (isOwner(userId) 
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'createdAt']))
                    || isAdmin();
      
      // Eliminación: no permitida (usar Auth para deshabilitar cuentas)
      allow delete: if false;
    }
    
    // ========================================================================
    // CURSOS (metadata pública, sin videoId)
    // ========================================================================
    match /courses/{courseId} {
      // Lectura: PÚBLICO para todos (para mostrar catálogo)
      allow read: if true;
      
      // Escritura: solo admin
      allow create, update: if isAdmin();
      
      // Eliminación: solo admin (considerar soft-delete en su lugar)
      allow delete: if isAdmin();
    }
    
    // ========================================================================
    // PRODUCTOS
    // ========================================================================
    match /products/{productId} {
      // Lectura: PÚBLICO para todos (para mostrar catálogo)
      allow read: if true;
      
      // Escritura: solo admin
      allow create, update: if isAdmin();
      
      // Eliminación: solo admin
      allow delete: if isAdmin();
    }
    
    // ========================================================================
    // COMPRAS (purchases)
    // ========================================================================
    match /purchases/{purchaseId} {
      // Lectura: solo el usuario que realizó la compra o admin
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Creación: usuario autenticado puede crear su propia compra
      // NOTA: esto es opcional; preferible crear solo desde Cloud Functions
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      
      // Actualización: SOLO desde servidor (Cloud Functions con Admin SDK)
      // Cliente NO puede actualizar status
      allow update: if isAdmin(); // Solo para casos excepcionales de admin manual
      
      // Eliminación: no permitida
      allow delete: if false;
    }
    
    // ========================================================================
    // ACCESOS A CURSOS (user_courses)
    // ========================================================================
    match /user_courses/{userCourseId} {
      // Lectura: solo el usuario propietario o admin
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Escritura: SOLO desde servidor (webhook de pagos)
      // Cliente NO puede crear/modificar accesos
      allow create, update, delete: if isAdmin(); // Solo admin manual en casos excepcionales
    }
    
    // ========================================================================
    // VIDEOS PRIVADOS (videos_private)
    // ========================================================================
    match /videos_private/{courseId} {
      // CRÍTICO: Cliente NUNCA debe acceder a esta colección
      // Solo Cloud Functions con Admin SDK pueden leer/escribir
      allow read, write: if false; // Bloquear todo acceso desde cliente
      
      // Nota: Admin SDK bypasea estas reglas, así que las funciones
      // serverless podrán acceder normalmente
    }
    
    // ========================================================================
    // LOGS DE ACCESO A VIDEOS
    // ========================================================================
    match /video_access_logs/{logId} {
      // Solo servidor puede escribir logs
      // Admin puede leer para auditoría
      allow read: if isAdmin();
      allow write: if false; // Solo Cloud Functions
    }
    
    // ========================================================================
    // PAGOS (registros de MercadoPago)
    // ========================================================================
    match /payments/{paymentId} {
      // Solo admin puede leer (para auditoría)
      allow read: if isAdmin();
      
      // Solo servidor puede escribir
      allow write: if false; // Solo Cloud Functions
    }
    
    // ========================================================================
    // VENTAS DE PRODUCTOS
    // ========================================================================
    match /sales/{saleId} {
      // Solo admin puede leer
      allow read: if isAdmin();
      
      // Solo servidor puede escribir
      allow write: if false; // Solo Cloud Functions
    }
    
    // ========================================================================
    // ÓRDENES/PEDIDOS
    // ========================================================================
    match /orders/{orderId} {
      // Lectura: usuario propietario o admin
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Creación: usuario autenticado puede crear su propio pedido
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
      
      // Actualización: solo admin o servidor
      allow update: if isAdmin();
      
      // Eliminación: solo admin
      allow delete: if isAdmin();
    }
    
    // ========================================================================
    // SOLICITUDES DE ACCESO
    // ========================================================================
    match /access_requests/{requestId} {
      // Lectura: solo admin
      allow read: if isAdmin();
      
      // Creación: cualquier persona puede enviar una solicitud (incluso no autenticada)
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'phone', 'status'])
                    && request.resource.data.status == 'pending';
      
      // Actualización: solo admin (para cambiar estado)
      allow update: if isAdmin();
      
      // Eliminación: solo admin
      allow delete: if isAdmin();
    }
    
    // ========================================================================
    // DENEGAR TODO LO DEMÁS POR DEFECTO
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

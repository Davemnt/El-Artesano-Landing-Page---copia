# Firebase Cloud Functions - Configuración de Entorno
# Copiar a .env para desarrollo local (nunca commitear .env)

# MercadoPago Access Token (usar Secret Manager en producción)
MP_ACCESS_TOKEN=TEST-1234567890-ACCESS-TOKEN-AQUI

# Clave secreta para cifrar videoIds (generar con: openssl rand -base64 32)
VIDEO_SECRET_KEY=YOUR_32_BYTES_BASE64_KEY_HERE

# URLs de retorno de MercadoPago
FRONTEND_URL=https://tu-dominio.com
SUCCESS_URL=https://tu-dominio.com/pago-exitoso.html
FAILURE_URL=https://tu-dominio.com/pago-fallido.html
PENDING_URL=https://tu-dominio.com/pago-pendiente.html

# URL del webhook (configurar en MercadoPago dashboard)
# Ejemplo: https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/mercadoPagoWebhook
WEBHOOK_URL=
